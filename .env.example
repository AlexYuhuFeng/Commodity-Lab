# AI provider (optional when configured in the desktop settings screen)
COMMODITY_LAB_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# Entitled S&P Global Commodity Insights (Platts) REST delivery
COMMODITY_LAB_PLATTS_BASE_URL=https://api.ci.spglobal.com
COMMODITY_LAB_PLATTS_AUTH_MODE=oauth_password
COMMODITY_LAB_PLATTS_USERNAME=
COMMODITY_LAB_PLATTS_PASSWORD=
# Alternatively provide a short-lived access token and use bearer mode.
COMMODITY_LAB_PLATTS_ACCESS_TOKEN=
COMMODITY_LAB_PLATTS_SYMBOL_MAP=C:\path\outside\the\repository\platts-symbol-map.json
COMMODITY_LAB_PLATTS_CACHE_TTL_SECONDS=900
COMMODITY_LAB_PLATTS_MAX_STALE_SECONDS=86400
