{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "package": {
    "productName": "Commodity Lab",
    "version": "0.1.0"
  },
  "build": {
    "distDir": "../tauri-frontend/dist",
    "devPath": "http://localhost:5173"
  },
  "tauri": {
    "windows": [
      {
        "title": "Commodity Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.alexyuhufeng.commoditylab",
      "icon": [
        "icons/icon.ico"
      ],
      "resources": [
        "../bundled/backend/*"
      ]
    }
  }
}
