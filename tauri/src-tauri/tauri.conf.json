{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "package": {
    "productName": "Commodity Lab",
    "version": "1.0.9"
  },
  "build": {
    "distDir": "../tauri-frontend/dist",
    "devPath": "http://localhost:5173"
  },
  "tauri": {
    "windows": [
      {
        "title": "Commodity Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "maximized": true,
        "fullscreen": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.alexyuhufeng.commoditylab",
      "publisher": "Commodity Lab",
      "copyright": "Copyright © 2026 Commodity Lab. All rights reserved.",
      "category": "Education",
      "shortDescription": "AI-generated natural gas hedging training terminal.",
      "longDescription": "Commodity Lab is a Windows desktop training terminal for natural gas hedging practice with AI-generated cases, training curves, deterministic local scoring, and Haineng-compatible AI coaching.",
      "icon": [
        "icons/icon.ico"
      ],
      "resources": [
        "../bundled/backend/*"
      ],
      "windows": {
        "allowDowngrades": false
      }
    }
  }
}
